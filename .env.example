MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=nourl
# PORT=9669
# NOTFOUND_FALLBACK_URL=   # unset = redirect unknown codes to https://{request host}

# Origin the OAuth providers redirect back to. The callback URL is built from
# it and has to match what is registered at each provider. Unset falls back to
# https://nourl.space, so local work against a provider must set it. 8080 is
# the Trunk dev server, which proxies /api to the backend on 9669.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Terraform (Cloudflare DNS + ACM validation); needs Zone:DNS:Edit on nourl.space
# CLOUDFLARE_API_TOKEN=

# Session token signing secret. Any long random string locally:
#   openssl rand -hex 32
JWT_SECRET=
# Session lifetime in days; applies to both the token and its cookie.
# JWT_SESSION_DAYS=60
# Set to false only if your browser refuses Secure cookies on localhost.
# COOKIE_SECURE=true
# How long a link keeps working after its owner's account is deleted. It goes
# unowned for this long, so anyone can claim it, and then expires.
# ORPHAN_GRACE_DAYS=7
